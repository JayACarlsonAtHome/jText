CREATE TABLE IF NOT EXISTS workshop_tools (
    id INTEGER NOT NULL,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    acquired DATE,
    condition TEXT NOT NULL,
    location TEXT,
    notes TEXT
);

-- Purpose: SQL Schema File
-- Related: type=PostgreSQL table=workshop_tools
--
CREATE TABLE IF NOT EXISTS workshop_tools (
    id INTEGER NOT NULL,
    name VARCHAR(80) NOT NULL,
    category VARCHAR(100) NOT NULL,
    acquired DATE,
    condition VARCHAR(30) NOT NULL,
    location VARCHAR(50),
    notes TEXT
);
